# Python / uv
__pycache__/
*.pyc
.venv/

# Jupyter
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# Data — raw and intermediate are regenerated, not committed
data/raw/*
!data/raw/.gitkeep
data/intermediate/*
!data/intermediate/.gitkeep

# Figures — regenerated by notebooks; keep the folder, not the contents
figures/*
!figures/.gitkeep

